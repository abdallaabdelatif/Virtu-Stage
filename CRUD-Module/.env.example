# Default: simple local development without Docker
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Alternative: PostgreSQL through Docker
# DATABASE_URL=postgresql://virtustage:virtustage_dev_password@localhost:5432/virtustage

INTERNAL_API_KEY=development-internal-key-change-me

# Required only for the one-time bootstrap script
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=AdminStrong@123