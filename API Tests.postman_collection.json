{
  "info": {
    "_postman_id": "5b7ff84c-42d8-4d75-9632-virtustage-api-tests",
    "name": "VirtuStage API Tests",
    "description": "Postman collection for testing the VirtuStage central backend API. Set baseUrl, testEmail, testPassword, and internalApiKey before running protected/internal requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const sessionId = pm.collectionVariables.get('sessionId');",
          "const uuidPattern = /^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i;",
          "if (!sessionId || !uuidPattern.test(sessionId)) {",
          "  pm.collectionVariables.set('sessionId', pm.variables.replaceIn('{{$guid}}'));",
          "}",
          "if (!pm.collectionVariables.get('testEmail')) {",
          "  pm.collectionVariables.set('testEmail', 'postman+' + Date.now() + '@example.com');",
          "}",
          "if (!pm.collectionVariables.get('testUsername')) {",
          "  pm.collectionVariables.set('testUsername', 'postman_' + Date.now());",
          "}",
          "if (!pm.collectionVariables.get('testPassword')) {",
          "  pm.collectionVariables.set('testPassword', 'TestPass123!');",
          "}"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.test('Response time is under 3000ms', function () {",
          "  pm.expect(pm.response.responseTime).to.be.below(3000);",
          "});"
        ]
      }
    }
  ],
